<?xml version="1.0" encoding="utf-8"?>
<!--
  Modelo do manifesto MSIX do SaguTerm (app desktop full trust).
  packaging/msix/build.ps1 troca os marcadores entre chaves duplas (VERSION,
  IDENTITY_NAME, PUBLISHER e PUBLISHER_DISPLAY_NAME) e grava o resultado em
  target\msix\layout\AppxManifest.xml. Os valores de identidade vem de
  packaging/msix/identity.json (Partner Center > Product identity) e sao
  sensiveis a maiusculas/minusculas.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>SaguTerm</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 17763 = Windows 10 1809 (primeiro com ConPTY); 26100 = Windows 11 24H2 (SDK do build) -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- Cada idioma listado aqui vira um idioma "suportado pelo pacote" no Partner Center -->
  <Resources>
    <Resource Language="pt-BR" />
  </Resources>

  <Applications>
    <!-- EntryPoint full trust em vez de uap10:RuntimeBehavior: funciona abaixo do 19041.
         O Id nao pode mudar depois de publicado (desloca o atalho no Iniciar). -->
    <Application Id="SaguTerm" Executable="SaguTerm.exe" EntryPoint="Windows.FullTrustApplication">
      <!-- Os logos so existem em versoes qualificadas (scale-*/targetsize-*);
           quem resolve os nomes-base abaixo e o resources.pri. -->
      <uap:VisualElements
        DisplayName="SaguTerm"
        Description="Cliente SSH e SFTP com cofre criptografado"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" ShortName="SaguTerm">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- App Win32 comum (egui, ConPTY, cmd.exe/wsl.exe no terminal local): exige full trust -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
